# The heartbeat of one holon: one beat every {{EVERY_S}} seconds.
# Written by heartbeat.py install; installed only by the person's own hand.
[Unit]
Description=The heartbeat of one holon, every {{EVERY_S}} seconds

[Timer]
OnBootSec={{EVERY_S}}s
OnUnitActiveSec={{EVERY_S}}s
AccuracySec=1s
Unit={{LABEL}}.service

[Install]
WantedBy=timers.target
