{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(bash scripts/room-post.sh:*)",
      "Bash(bash scripts/pad-write.sh:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(python3 -I engine/record.py read:*)",
      "Bash(python3 -I engine/record.py fold:*)",
      "Bash(python3 -I engine/record.py verify:*)",
      "Bash(python3 -I engine/engine.py:*)",
      "Bash(python3 -I engine/conformance.py:*)",
      "Bash(python3 -I engine/mail.py badge:*)",
      "Bash(python3 -I engine/mail.py carried:*)",
      "Bash(python3 -I engine/holon.py pull:*)",
      "Bash(python3 -I engine/mail.py fetch:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/desk\" start || true",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/now-hook\" || true",
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/desk\" guard || true",
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/desk\" end || true",
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
