{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(bash scripts/room-post.sh:*)",
      "Bash(bash scripts/pad-write.sh:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(python3 -I engine/record.py read:*)",
      "Bash(python3 -I engine/record.py fold:*)",
      "Bash(python3 -I engine/record.py verify:*)",
      "Bash(python3 -I engine/engine.py:*)",
      "Bash(python3 -I engine/conformance.py:*)",
      "Bash(python3 -I engine/mail.py badge:*)",
      "Bash(python3 -I engine/mail.py carried:*)",
      "Bash(python3 -I engine/holon.py pull:*)",
      "Bash(python3 -I engine/mail.py fetch:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/scripts/desk.ps1",
              "start"
            ],
            "timeout": 15,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/scripts/now-hook.ps1"
            ],
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/scripts/desk.ps1",
              "guard"
            ],
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/scripts/desk.ps1",
              "end"
            ],
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
